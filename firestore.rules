rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(teamId) { return /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid); }
    function isMember(teamId) { return signedIn() && exists(memberPath(teamId)) && get(memberPath(teamId)).data.active == true; }
    function member(teamId) { return get(memberPath(teamId)).data; }
    function isCoach(teamId) { return isMember(teamId) && member(teamId).role in ['headCoach', 'assistantCoach']; }
    function isHeadCoach(teamId) { return isMember(teamId) && member(teamId).role == 'headCoach'; }
    function familyId(teamId) { return member(teamId).get('familyId', null); }
    function hasPlayerAccess(teamId, playerId) {
      return isMember(teamId) && (
        playerId in member(teamId).get('playerIds', [])
        || (
          familyId(teamId) != null
          && get(/databases/$(database)/documents/teams/$(teamId)/players/$(playerId)).data.familyId == familyId(teamId)
        )
      );
    }
    function hasGuardianConversation(teamId, guardianId) {
      return isMember(teamId) && guardianId in member(teamId).get('guardianIds', []);
    }
    function validText(value, maxLength) { return value is string && value.size() > 0 && value.size() <= maxLength; }
    function ownsPlayer(teamId, playerId) {
      return hasPlayerAccess(teamId, playerId);
    }
    function eventData(teamId, eventId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/events/$(eventId)).data;
    }
    function rsvpAfter(teamId, eventId, playerId) {
      return getAfter(/databases/$(database)/documents/teams/$(teamId)/events/$(eventId)/rsvps/$(playerId)).data;
    }
    function slotAfter(teamId, eventId, slotId) {
      return getAfter(/databases/$(database)/documents/teams/$(teamId)/events/$(eventId)/slots/$(slotId)).data;
    }
    function invitePath(teamId) { return /databases/$(database)/documents/teams/$(teamId)/invites/$(request.auth.token.email); }
    function inviteForPath(teamId, email) { return /databases/$(database)/documents/teams/$(teamId)/invites/$(email); }
    function validOwnInvite(teamId) {
      return signedIn() && request.auth.token.email_verified == true && exists(invitePath(teamId)) && get(invitePath(teamId)).data.active == true;
    }
    function isCoachPromotionInvite(teamId, email) {
      return request.resource.data.email == email
        && request.resource.data.role == 'assistantCoach'
        && request.resource.data.active == true
        && request.resource.data.get('playerIds', []).size() > 0
        && request.resource.data.get('guardianIds', []).size() > 0
        && existsAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.guardianIds[0]))
        && getAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.guardianIds[0])).data.email == email
        && getAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.guardianIds[0])).data.playerId in request.resource.data.playerIds;
    }
    function isCoachPromotionMember(teamId) {
      return resource.data.role in ['guardian', 'parent']
        && request.resource.data.role == 'assistantCoach'
        && request.resource.data.email == resource.data.email
        && request.resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'familyId', 'playerIds', 'guardianIds', 'active'])
        && existsAfter(inviteForPath(teamId, request.resource.data.email))
        && getAfter(inviteForPath(teamId, request.resource.data.email)).data.role == 'assistantCoach'
        && request.resource.data.familyId == getAfter(inviteForPath(teamId, request.resource.data.email)).data.get('familyId', null)
        && request.resource.data.playerIds == getAfter(inviteForPath(teamId, request.resource.data.email)).data.get('playerIds', [])
        && request.resource.data.guardianIds == getAfter(inviteForPath(teamId, request.resource.data.email)).data.get('guardianIds', []);
    }
    function isNewCoachInvite(teamId, email) {
      return isCoach(teamId)
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'familyId', 'playerIds', 'guardianIds', 'active', 'invitedAt', 'invitedByUid'])
        && request.resource.data.email == email
        && validText(request.resource.data.name, 100)
        && request.resource.data.role == 'assistantCoach'
        && request.resource.data.get('familyId', null) == null
        && request.resource.data.get('playerIds', []).size() == 0
        && request.resource.data.get('guardianIds', []).size() == 0
        && request.resource.data.active == true
        && request.resource.data.invitedAt is string
        && request.resource.data.invitedByUid == request.auth.uid;
    }
    function isSelfCoachClaimMember(teamId, userId) {
      let oldPlayerIds = resource.data.get('playerIds', []);
      let oldGuardianIds = resource.data.get('guardianIds', []);
      let newPlayerIds = request.resource.data.get('playerIds', []);
      let newGuardianIds = request.resource.data.get('guardianIds', []);
      return isCoach(teamId)
        && request.auth.uid == userId
        && resource.data.role in ['headCoach', 'assistantCoach']
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.active == resource.data.active
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds', 'guardianIds', 'lastClaimedPlayerId', 'lastClaimedGuardianId', 'lastClaimedAt'])
        && validText(request.resource.data.get('lastClaimedPlayerId', ''), 200)
        && validText(request.resource.data.get('lastClaimedGuardianId', ''), 200)
        && request.resource.data.lastClaimedAt is string
        && newPlayerIds.size() == oldPlayerIds.size() + 1
        && newGuardianIds.size() == oldGuardianIds.size() + 1
        && newPlayerIds.hasAll(oldPlayerIds)
        && newGuardianIds.hasAll(oldGuardianIds)
        && request.resource.data.lastClaimedPlayerId in newPlayerIds
        && !(request.resource.data.lastClaimedPlayerId in oldPlayerIds)
        && request.resource.data.lastClaimedGuardianId in newGuardianIds
        && !(request.resource.data.lastClaimedGuardianId in oldGuardianIds)
        && existsAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.lastClaimedGuardianId))
        && getAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.lastClaimedGuardianId)).data.email == resource.data.email
        && getAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.lastClaimedGuardianId)).data.relationship == 'parent'
        && getAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.lastClaimedGuardianId)).data.active == true
        && getAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.lastClaimedGuardianId)).data.playerId == request.resource.data.lastClaimedPlayerId;
    }
    function validDocumentData(teamId) {
      return request.resource.data.keys().hasOnly(['title', 'category', 'fileName', 'url', 'path', 'contentType', 'size', 'uploadedAt', 'uploadedByUid', 'updatedAt', 'updatedByUid', 'copiedFromId'])
        && validText(request.resource.data.title, 120)
        && request.resource.data.category in ['pdf', 'map', 'photo']
        && validText(request.resource.data.fileName, 254)
        && validText(request.resource.data.url, 2000)
        && validText(request.resource.data.path, 500)
        && request.resource.data.path.matches('teams/' + teamId + '/documents/.*')
        && request.resource.data.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size < 10 * 1024 * 1024
        && request.resource.data.uploadedAt is string
        && validText(request.resource.data.uploadedByUid, 200)
        && request.resource.data.updatedAt is string
        && validText(request.resource.data.updatedByUid, 200)
        && (request.resource.data.get('copiedFromId', null) == null || validText(request.resource.data.copiedFromId, 200));
    }

    match /teams/{teamId} {
      allow read: if isMember(teamId);
      allow create, delete: if isHeadCoach(teamId);
      allow update: if isCoach(teamId);

      match /members/{userId} {
        allow read: if isCoach(teamId) || (signedIn() && request.auth.uid == userId);
        allow create: if signedIn() && request.auth.uid == userId && validOwnInvite(teamId)
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == get(invitePath(teamId)).data.role
          && request.resource.data.familyId == get(invitePath(teamId)).data.get('familyId', null)
          && request.resource.data.playerIds == get(invitePath(teamId)).data.get('playerIds', [])
          && request.resource.data.guardianIds == get(invitePath(teamId)).data.get('guardianIds', [])
          && request.resource.data.active == true;
        allow update: if isHeadCoach(teamId) || (isCoach(teamId) && isCoachPromotionMember(teamId)) || isSelfCoachClaimMember(teamId, userId) || (
          signedIn()
          && request.auth.uid == userId
          && resource.data.active == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt'])
          && request.resource.data.lastLoginAt is string
        );
        allow delete: if isHeadCoach(teamId);
      }

      match /invites/{email} {
        allow read: if isCoach(teamId) || (signedIn() && request.auth.token.email == email);
        allow create: if isHeadCoach(teamId) || (isCoach(teamId) && isCoachPromotionInvite(teamId, email)) || isNewCoachInvite(teamId, email);
        allow update: if isHeadCoach(teamId) || (
          isCoach(teamId)
          && resource.data.role in ['guardian', 'parent']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'role', 'familyId', 'playerIds', 'guardianIds', 'active'])
          && isCoachPromotionInvite(teamId, email)
        ) || (resource.data.active == false && isNewCoachInvite(teamId, email));
        allow delete: if isHeadCoach(teamId);
      }

      match /families/{requestedFamilyId} {
        allow read: if isCoach(teamId) || (isMember(teamId) && familyId(teamId) == requestedFamilyId);
        allow write: if isCoach(teamId);
        match /private/{document=**} {
          allow read, write: if isCoach(teamId) || (isMember(teamId) && familyId(teamId) == requestedFamilyId);
        }
      }

      match /guardians/{guardianId} {
        allow read: if isCoach(teamId) || hasGuardianConversation(teamId, guardianId);
        allow create: if isHeadCoach(teamId) || (
          isCoach(teamId)
          && request.resource.data.keys().hasOnly(['playerId', 'name', 'email', 'relationship', 'active', 'createdAt', 'createdByUid'])
          && exists(/databases/$(database)/documents/teams/$(teamId)/players/$(request.resource.data.playerId))
          && validText(request.resource.data.name, 100)
          && validText(request.resource.data.email, 254)
          && request.resource.data.relationship == 'parent'
          && request.resource.data.active == true
          && request.resource.data.createdByUid == request.auth.uid
        );
        allow update, delete: if isHeadCoach(teamId);
      }

      match /players/{playerId} {
        allow get: if isCoach(teamId) || hasPlayerAccess(teamId, playerId);
        allow list: if isCoach(teamId) || (
          isMember(teamId)
          && familyId(teamId) != null
          && resource.data.familyId == familyId(teamId)
        );
        allow write: if isCoach(teamId);

        match /sharedObservations/{observationId} {
          allow read: if isCoach(teamId) || ownsPlayer(teamId, playerId);
          allow write: if isCoach(teamId);
        }
        match /privateObservations/{observationId} {
          allow read, write: if isCoach(teamId);
        }
      }

      match /events/{eventId} {
        allow read: if isMember(teamId);
        allow write: if isCoach(teamId);
        match /rsvps/{playerId} {
          allow read: if isCoach(teamId) || ownsPlayer(teamId, playerId);
          allow create, update: if isCoach(teamId) || (
            ownsPlayer(teamId, playerId)
            && request.resource.data.keys().hasOnly(['playerId', 'userId', 'status', 'slotId', 'updatedAt', 'gameId'])
            && request.resource.data.playerId == playerId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.get('gameId', eventId) == eventId
            && request.resource.data.status in ['yes', 'no', 'maybe']
            && request.resource.data.updatedAt is string
            && (
              (
                request.resource.data.status == 'yes'
                && (
                  (
                    eventData(teamId, eventId).get('slotCapacity', 0) == 0
                    && request.resource.data.get('slotId', null) == null
                  )
                  || (
                    eventData(teamId, eventId).get('slotCapacity', 0) > 0
                    && request.resource.data.slotId is string
                    && slotAfter(teamId, eventId, request.resource.data.slotId).playerId == playerId
                  )
                )
              )
              || (
                request.resource.data.status in ['no', 'maybe']
                && request.resource.data.get('slotId', null) == null
              )
            )
          );
          allow delete: if isCoach(teamId);
        }
        match /slots/{slotId} {
          allow read: if isMember(teamId);
          allow create, delete: if isCoach(teamId);
          allow update: if isCoach(teamId) || (
            isMember(teamId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerId', 'userId', 'assignedAt'])
            && (
              (
                resource.data.get('playerId', null) == null
                && request.resource.data.playerId is string
                && ownsPlayer(teamId, request.resource.data.playerId)
                && request.resource.data.userId == request.auth.uid
                && request.resource.data.assignedAt is string
                && rsvpAfter(teamId, eventId, request.resource.data.playerId).status == 'yes'
                && rsvpAfter(teamId, eventId, request.resource.data.playerId).slotId == slotId
              )
              || (
                resource.data.get('playerId', null) is string
                && ownsPlayer(teamId, resource.data.playerId)
                && request.resource.data.get('playerId', null) == null
                && request.resource.data.get('userId', null) == null
                && request.resource.data.get('assignedAt', null) == null
                && rsvpAfter(teamId, eventId, resource.data.playerId).status in ['no', 'maybe']
                && rsvpAfter(teamId, eventId, resource.data.playerId).get('slotId', null) == null
              )
            )
          );
        }
      }

      match /sessions/{sessionId} { allow read, write: if isCoach(teamId); }

      match /drillCards/{drillId} {
        allow read, write: if isCoach(teamId);
      }

      match /documents/{documentId} {
        allow read: if isMember(teamId);
        allow create: if isCoach(teamId)
          && validDocumentData(teamId)
          && request.resource.data.uploadedByUid == request.auth.uid
          && request.resource.data.updatedByUid == request.auth.uid;
        allow update: if isCoach(teamId)
          && validDocumentData(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'updatedAt', 'updatedByUid'])
          && request.resource.data.updatedByUid == request.auth.uid;
        allow delete: if isCoach(teamId);
      }

      match /volunteerSlots/{slotId} {
        allow read: if isMember(teamId);
        allow create, delete: if isCoach(teamId);
        allow update: if isCoach(teamId) || (
          isMember(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneeFamilyId'])
          && (
            (resource.data.get('assigneeFamilyId', null) == null && request.resource.data.assigneeFamilyId == familyId(teamId))
            || (resource.data.get('assigneeFamilyId', null) == familyId(teamId) && request.resource.data.get('assigneeFamilyId', null) == null)
          )
        );
      }

      match /broadcasts/{broadcastId} {
        allow read: if isMember(teamId);
        allow create: if isCoach(teamId)
          && request.resource.data.keys().hasOnly(['familyIds', 'title', 'body', 'attachments', 'actionButton', 'sentByUid', 'sentByLabel', 'sentAt'])
          && request.resource.data.familyIds is list && request.resource.data.familyIds.size() == 0
          && validText(request.resource.data.title, 120)
          && validText(request.resource.data.body, 8000)
          && request.resource.data.sentByUid == request.auth.uid
          && validText(request.resource.data.sentByLabel, 80)
          && request.resource.data.sentAt is string;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isCoach(teamId)
          || (resource.data.get('guardianId', null) != null && hasGuardianConversation(teamId, resource.data.guardianId))
          || (resource.data.get('familyId', null) != null && isMember(teamId) && resource.data.familyId == familyId(teamId));
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['familyId', 'guardianId', 'playerId', 'body', 'senderUid', 'senderRole', 'senderLabel', 'createdAt'])
          && validText(request.resource.data.body, 4000)
          && request.resource.data.senderUid == request.auth.uid
          && validText(request.resource.data.senderLabel, 100)
          && request.resource.data.createdAt is string
          && (
            (
              isCoach(teamId)
              && request.resource.data.senderRole == 'coach'
              && (
                (
                  request.resource.data.get('guardianId', null) != null
                  && request.resource.data.get('playerId', null) != null
                  && existsAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.guardianId))
                  && getAfter(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.guardianId)).data.playerId == request.resource.data.playerId
                )
                || (
                  request.resource.data.get('familyId', null) != null
                  && exists(/databases/$(database)/documents/teams/$(teamId)/families/$(request.resource.data.familyId))
                )
              )
            )
            || (
              member(teamId).role in ['guardian', 'parent', 'headCoach', 'assistantCoach']
              && request.resource.data.senderRole == 'guardian'
              && (
                (
                  request.resource.data.get('guardianId', null) != null
                  && request.resource.data.get('playerId', null) != null
                  && hasGuardianConversation(teamId, request.resource.data.guardianId)
                  && hasPlayerAccess(teamId, request.resource.data.playerId)
                  && get(/databases/$(database)/documents/teams/$(teamId)/guardians/$(request.resource.data.guardianId)).data.playerId == request.resource.data.playerId
                )
                || (
                  request.resource.data.get('familyId', null) != null
                  && request.resource.data.familyId == familyId(teamId)
                  && exists(/databases/$(database)/documents/teams/$(teamId)/families/$(request.resource.data.familyId))
                )
              )
            )
          );
        allow update, delete: if false;
      }

      match /{document=**} { allow read, write: if false; }
    }
  }
}
