rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function membership(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }
    function membershipExists(teamId) {
      return firestore.exists(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }
    function isMember(teamId) {
      return request.auth != null && membershipExists(teamId) && membership(teamId).data.active == true;
    }
    function isCoach(teamId) { return isMember(teamId) && membership(teamId).data.role in ['headCoach', 'assistantCoach']; }
    match /coachTeams/{teamId}/drill-cards/{allPaths=**} {
      allow read: if isCoach(teamId);
      allow write: if isCoach(teamId) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/png';
    }
    match /teams/{teamId}/documents/{documentId}/{allPaths=**} {
      allow read: if isMember(teamId);
      allow create, update: if isCoach(teamId)
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];
      allow delete: if isCoach(teamId);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
